{
  "name": "@astrajs/compiler",
  "version": "0.1.0",
  "description": "AstraJS Compiler — Vite plugin, AST transformer, CSS extractor",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrajs/core": "workspace:*",
    "@astrajs/server": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "keywords": ["astrajs", "compiler", "vite-plugin", "ast", "css-in-js"],
  "license": "MIT"
}
