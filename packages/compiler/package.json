{
  "name": "@astrajs/compiler",
  "version": "0.1.19",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpjs159/astrajs.git"
  },
  "description": "AstraJS Compiler — Vite plugin, AST transformer, CSS extractor",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": {
      "development": "./src/css.ts",
      "import": "./dist/css.js",
      "default": "./dist/css.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrajs/ai": "*",
    "@astrajs/core": "*",
    "@astrajs/server": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "keywords": [
    "astrajs",
    "compiler",
    "vite-plugin",
    "ast",
    "css-in-js"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
