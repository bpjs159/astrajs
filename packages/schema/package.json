{
  "name": "@bpjs159/schema",
  "version": "0.1.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpjs159/astrajs.git"
  },
  "description": "AstraJS Schema — Declarative validation with inferred types",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bpjs159/core": "0.1.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
