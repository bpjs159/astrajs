{
  "name": "@bpjs159/router",
  "version": "0.1.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpjs159/astrajs.git"
  },
  "description": "AstraJS Router — Isomorphic routing with <Outlet /> and View Transitions",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@bpjs159/core": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "astrajs",
    "router",
    "view-transitions",
    "isomorphic"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
