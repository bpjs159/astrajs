{
  "name": "@astrajs/core",
  "version": "0.1.0",
  "description": "AstraJS Core — Proxy-based reactivity runtime and JSX types",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./validation": {
      "development": "./src/validation.ts",
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "default": "./dist/validation.js"
    },
    "./vite": {
      "development": "./src/compiler/index.ts",
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js",
      "default": "./dist/compiler/index.js"
    },
    "./jsx-runtime": {
      "development": "./src/jsx-runtime.ts",
      "import": "./src/jsx-runtime.ts",
      "default": "./src/jsx-runtime.ts"
    },
    "./jsx-dev-runtime": {
      "development": "./src/jsx-dev-runtime.ts",
      "import": "./src/jsx-dev-runtime.ts",
      "default": "./src/jsx-dev-runtime.ts"
    }
  },
  "typesVersions": {
    "0.1.0": {
      "0.1.0": [
        "./dist/index.d.ts"
      ],
      "validation": [
        "./dist/validation.d.ts"
      ],
      "vite": [
        "./dist/compiler/index.d.ts"
      ]
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrajs/validation": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {},
  "keywords": [
    "astrajs",
    "reactivity",
    "proxy",
    "zero-vdom"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
