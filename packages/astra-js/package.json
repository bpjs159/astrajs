{
  "name": "astrajs.dev",
  "version": "0.1.9",
  "description": "AstraJS — Full-Stack TypeScript Framework. One install, dynamic subpath imports: astrajs.dev/core, astrajs.dev/compiler, astrajs.dev/server…",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpjs159/astrajs.git"
  },
  "bin": {
    "astrajs": "./bin/astra.js",
    "astra": "./bin/astra.js",
    "create-astrajs": "./bin/astra.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./core/validation": {
      "types": "./dist/core-validation.d.ts",
      "import": "./dist/core-validation.js",
      "default": "./dist/core-validation.js"
    },
    "./core/jsx-runtime": {
      "types": "./dist/core-jsx-runtime.d.ts",
      "import": "./dist/core-jsx-runtime.js",
      "default": "./dist/core-jsx-runtime.js"
    },
    "./core/jsx-dev-runtime": {
      "types": "./dist/core-jsx-dev-runtime.d.ts",
      "import": "./dist/core-jsx-dev-runtime.js",
      "default": "./dist/core-jsx-dev-runtime.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js",
      "default": "./dist/compiler.js"
    },
    "./compiler/css": {
      "types": "./dist/compiler-css.d.ts",
      "import": "./dist/compiler-css.js",
      "default": "./dist/compiler-css.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js",
      "default": "./dist/ssr.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js",
      "default": "./dist/router.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "default": "./dist/i18n.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js",
      "default": "./dist/form.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "default": "./dist/validation.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "default": "./dist/ai.js"
    },
    "./ai/rag": {
      "types": "./dist/ai-rag.d.ts",
      "import": "./dist/ai-rag.js",
      "default": "./dist/ai-rag.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js",
      "default": "./dist/adapters.js"
    },
    "./adapters/edge": {
      "types": "./dist/adapters-edge.d.ts",
      "import": "./dist/adapters-edge.js",
      "default": "./dist/adapters-edge.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "vendor"
  ],
  "scripts": {
    "build": "node scripts/vendor.mjs && tsc"
  },
  "dependencies": {
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "astrajs",
    "framework",
    "typescript",
    "vite",
    "ssr",
    "reactive",
    "no-vdom"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
