{
  "name": "@bpjs159/ssr",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpjs159/astrajs.git"
  },
  "description": "AstraJS SSR — Server-side renderer, SSG crawler, HTML stringifier, ISR",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@bpjs159/core": "0.1.0",
    "@bpjs159/router": "0.1.0",
    "@bpjs159/server": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "astrajs",
    "ssr",
    "ssg",
    "isr",
    "resumability"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
