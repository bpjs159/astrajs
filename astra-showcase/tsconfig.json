{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "jsxImportSource": "@astrajs/core",
    "types": [],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@astrajs/core": ["../packages/core/src"],
      "@astrajs/core/jsx-runtime": ["../packages/core/src/jsx-runtime"],
      "@astrajs/core/jsx-dev-runtime": ["../packages/core/src/jsx-dev-runtime"],
      "@astrajs/core/vite": ["../packages/core/src/compiler"],
      "@astrajs/router": ["../packages/router/src"],
      "@astrajs/server": ["../packages/server/src"],
      "@astrajs/ssr": ["../packages/ssr/src"],
      "@astrajs/compiler": ["../packages/compiler/src"]
    }
  },
  "include": [
    "src",
    "../packages/core/src/jsx.d.ts",
    "../packages/core/src/jsx-runtime.d.ts"
  ],
  "references": [
    { "path": "../packages/core" },
    { "path": "../packages/router" },
    { "path": "../packages/server" },
    { "path": "../packages/ssr" },
    { "path": "../packages/compiler" }
  ]
}
