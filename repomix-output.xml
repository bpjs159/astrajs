    expect(f.isValidating).toBe(false);
  });

  it('focusFirstError does not throw when not attached', () => {
    const f = form();
    expect(() => f.focusFirstError()).not.toThrow();
  });

  it('validateAll does not throw when not attached', () => {
    const f = form();
    expect(() => f.validateAll()).not.toThrow();
  });
});
