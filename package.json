    "test": "pnpm -r run test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "jsdom": "^29.1.1",
    "vitest": "^2.0.0"
  }
}
