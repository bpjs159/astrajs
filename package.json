{
  "name": "astrajs-workspace",
  "version": "0.1.15",
  "private": true,
  "description": "AstraJS — Full-Stack TypeScript Framework: Zero-VDOM, AST-compiled, Proxy-reactive",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky",
    "deploy": "node scripts/deploy.mjs",
    "publish:beta": "node scripts/publish.mjs --tag beta",
    "publish:latest": "node scripts/publish.mjs --tag latest",
    "publish:dry": "node scripts/publish.mjs --dry-run",
    "publish:promote": "node scripts/promote.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "astra-site",
    "astra-blog",
    "examples/*/*",
    "astra-store",
    "astra-dash",
    "astra-tasks"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "vitest": "^2.0.0"
  }
}
