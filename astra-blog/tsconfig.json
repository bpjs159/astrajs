{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@bpjs159/core",
    "rootDir": "..",
    "paths": {
      "@bpjs159/core": ["../packages/core/src"],
      "@bpjs159/core/jsx-runtime": ["../packages/core/src/jsx-runtime"],
      "@bpjs159/core/jsx-dev-runtime": ["../packages/core/src/jsx-dev-runtime"],
      "@bpjs159/router": ["../packages/router/src"],
      "@bpjs159/server": ["../packages/server/src"],
      "@bpjs159/i18n": ["../packages/i18n/src"],
      "@bpjs159/compiler/css": ["../packages/compiler/src/css"],
      "@bpjs159/compiler": ["../packages/compiler/src"]
    }
  },
  "include": [
    "src",
    "../packages/core/src/jsx.d.ts"
  ]
}
